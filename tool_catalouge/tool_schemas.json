    "get_customer": {
      "id": "T-001",
      "description": "Retrieve a synthetic customer by customer_id",
      "allowed_roles": [
        "Analyst",
        "Supervisor"
      ],
      "controls": "Read-only; BR-004/027",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "not_found",
              "error"
            ]
          },
          "data": {
            "type": [
              "object",
              "array",
              "null"
            ],
            "description": "customer record or not_found; exact field-level model requires prior API/agent specification"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            ]
          },
          "audit_event_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "data",
          "error"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "error"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "error": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "success"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "approval_status": "draft_pending_coach_review"
    },
