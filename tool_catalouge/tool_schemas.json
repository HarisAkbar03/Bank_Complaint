    "search_policy": {
      "id": "T-004",
      "description": "Retrieve approved policy chunks",
      "allowed_roles": [
        "Analyst",
        "Supervisor"
      ],
      "controls": "Current version/access filters",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "filters": {
            "type": "object",
            "description": "Only allowlisted server-validated filters; caller cannot broaden document access",
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean",
                "array"
              ]
            }
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query",
          "filters",
          "top_k"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "not_found",
              "error"
            ]
          },
          "data": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "chunk_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "chunk_id",
                "text",
                "metadata"
              ],
              "additionalProperties": true
            }
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            ]
          },
          "audit_event_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "data",
          "error"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "error"
                }
              },
              "required": [
                "status"
